# Environment
NODE_ENV=development
TR_PORT=3000
# Signs auth tokens. Generate one with `openssl rand -hex 32`. Required when NODE_ENV=production;
# when empty, a random secret is used per process (sign-ins do not survive a restart).
TR_SECRET=
TR_VIRTUAL_HOST=http://localhost:8080
TR_PUBLIC_DIR=/path/to/public
TR_TEMPLATES_DIR=/path/to/templates

# CORS and Logging
TR_CORS_ENABLED=true
TR_ACCESS_LOGS_ENABLED=true

# Authentication
TR_AUTH_TOKEN_EXPIRES=86400
TR_SIGNUPS_ENABLED=true

# Throttling - Global
TR_THROTTLE_TTL=60000
TR_THROTTLE_LIMIT=0

# Throttling - Auth
TR_AUTH_THROTTLE_TTL=60000
TR_AUTH_THROTTLE_LIMIT=10

# Database Configuration
TR_DB_TYPE=mysql
TR_DB_HOST=localhost
TR_DB_PORT=3306
TR_DB_USER=myuser
TR_DB_PASSWORD=mypassword
TR_DB_DATABASE=mydatabase

# Database Migration
TR_DB_AUTOMIGRATE=true

# Project Limits
TR_MAX_PROJECTS_PER_USER=100
TR_DEFAULT_PROJECT_PLAN=open-source

# Import Settings
TR_IMPORT_MAX_NESTED_LEVELS=5

# Google OAuth Provider
TR_AUTH_GOOGLE_ENABLED=false
TR_AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
TR_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
TR_AUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Mail Configuration
TR_MAIL_DEBUG=true
TR_MAIL_SENDER=no-reply@myapp.com
TR_MAIL_HOST=smtp.mailtrap.io
TR_MAIL_PORT=587
TR_MAIL_SECURE=false
TR_MAIL_REJECT_SELF_SIGNED=true
TR_MAIL_USER=myuser
TR_MAIL_PASSWORD=mypassword

# Seed Admin User Automatically
# The admin is created only when TR_ADMIN_PASSWORD is set. Choose your own password: there is no default.
TR_SEED_DATA=true
TR_ADMIN_EMAIL=local.admin@ever.co
TR_ADMIN_PASSWORD=
TR_ADMIN_NAME=Admin

# Anonymous usage statistics (on unless exactly 'false'). Sends counts and two settings once a day to Ever Platform,
# never names, e-mails or project contents. 'false' turns them off entirely (nothing loaded, nothing sent); the operator
# can also turn them off on the Ever Platform page. See docs/ever-platform/anonymous-usage-statistics.md
TR_EVER_STATS_ENABLED=
# Where reports go: TR_EVER_STATS_API_URL, else TR_EVER_PLATFORM_API_URL, else https://api.ever.co
# TR_EVER_STATS_API_URL=https://api.ever.co
# TR_EVER_PLATFORM_API_URL=https://api.ever.co
# TR_EVER_STATS_COUNTRY=ZZ
# TR_EVER_INSTALL_SOURCE=self-hosted
# Users who operate this installation (comma separated); default TR_ADMIN_EMAIL
# TR_EVER_ADMIN_EMAILS=

# Ever Platform connection (off unless 'true'). Nothing is sent before an operator connects with a code from
# app.ever.co. See docs/ever-platform/connection.md
TR_EVER_CONNECT_ENABLED=
# TR_EVER_CONNECT_CODE=
# TR_EVER_CONNECT_INTEGRATIONS_DENY=
# TR_EVER_CONNECT_FEED_MODE=longpoll
# Projects created from app.ever.co (hand-off; off unless 'true', and only with the connection on)
# TR_EVER_CONNECT_PROVISION_ENABLED=
# A person's export request from app.ever.co answered with an export they download here (off unless 'true'; needs the
# installation's https address reported under Installation address)
# TR_EVER_CONNECT_PERSON_EXPORT_ENABLED=
# A person's deletion request from app.ever.co deletes the matched accounts, unless one operates this installation or
# is the last admin of a project (off unless 'true': only the Ever ID is removed)
# TR_EVER_CONNECT_PERSON_DELETION_ENABLED=
